      "versionNonce": 1381010,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Saving a word answers \"what does this mean\".\nIndexing its kanji answers \"which characters do I\nnot know\" — and lets the same character light up\ninside a different word in a different book.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Saving a word answers \"what does this mean\".\nIndexing its kanji answers \"which characters do I\nnot know\" — and lets the same character light up\ninside a different word in a different book.",
      "lineHeight": 1.25,
      "autoResize": true
    },
